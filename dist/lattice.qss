}

QTabWidget::pane {
  background: #ffffff;
  border: 1px solid #d9dee5;
}

QTabBar::tab {
  background: transparent;
  color: #5a6676;
  border-bottom: 2px solid transparent;
  padding: 8px 16px;
}

QTabBar::tab:selected {
  color: #1d2430;
