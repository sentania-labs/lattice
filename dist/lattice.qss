}

QGroupBox {
  border: 1px solid #d9dee5;
  border-radius: 4px;
  margin-top: 12px;
  padding: 8px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  color: #5a6676;
  padding: 0px 4px;
}

QProgressBar {
  background: #eef1f5;
  color: #1d2430;
  border: 1px solid #d9dee5;
  border-radius: 3px;
  text-align: center;
}

QProgressBar::chunk {
  background: #1f5fbf;
}

QMenu, QMenuBar, QStatusBar, QToolBar {
  background: #ffffff;
  color: #1d2430;
}

QMenu::item:selected, QMenuBar::item:selected {
  background: #1f5fbf;
  color: #ffffff;
}

QScrollBar:vertical {
  background: #f6f7f9;
  width: 8px;
}

QScrollBar::handle:vertical {
  background: #d9dee5;
  border-radius: 4px;
  min-height: 24px;
}

QScrollBar::handle:vertical:hover {
  background: #8b95a3;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
