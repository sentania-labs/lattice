/* Use Fusion + matching lattice-palette.json for native indicators and unstyled controls. */

QWidget {
  color: #1d2430;
  font-size: 13px;
  selection-background-color: #1f5fbf;
  selection-color: #ffffff;
}

QMainWindow, QDialog, QWidget#lattice-root {
  background: #f6f7f9;
}

QLabel {
  background: transparent;
}

QToolTip {
  background: #ffffff;
  color: #1d2430;
  border: 1px solid #d9dee5;
  padding: 4px;
}

QFrame[lattice="card"] {
  background: #ffffff;
  border: 1px solid #d9dee5;
  border-radius: 9px;
}

QFrame[lattice="header"] {
  background: #ffffff;
  border: 1px solid #d9dee5;
  border-radius: 4px;
}

QFrame[lattice="sidebar"] {
  background: #ffffff;
  border: 1px solid #d9dee5;
  border-radius: 4px;
}

QLabel[lattice="page-title"] {
  font-size: 17px;
  font-weight: 650;
}

QLabel[lattice="section-label"] {
  font-size: 13px;
  font-weight: 650;
}

QLabel[lattice="subhead"] {
  font-size: 14px;
  font-weight: 650;
}

QLabel[lattice="body"] {
  font-size: 14px;
  font-weight: 400;
}

QLabel[lattice="ui"] {
  font-size: 13px;
  font-weight: 400;
}

QLabel[lattice="label"] {
