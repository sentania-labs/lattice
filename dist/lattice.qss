}

QPushButton {
  background: #ffffff;
  color: #1d2430;
  border: 1px solid #d9dee5;
  border-radius: 6px;
  padding: 6px 12px;
}

QPushButton:hover {
  background: #eef1f5;
  border-color: #8b95a3;
}

QPushButton:pressed, QPushButton:checked {
  background: #e8f0fc;
  color: #12376f;
}

QPushButton[variant="primary"] {
  background: #1f5fbf;
  color: #ffffff;
  border-color: #1f5fbf;
}

QPushButton[variant="primary"]:hover, QPushButton[variant="primary"]:pressed, QPushButton[variant="primary"]:checked {
  background: #1a4fa0;
}

QPushButton[variant="ghost"] {
  background: transparent;
  color: #5a6676;
  border-color: transparent;
}

QPushButton[variant="ghost"]:hover, QPushButton[variant="ghost"]:pressed, QPushButton[variant="ghost"]:checked {
  background: #eef1f5;
}

QPushButton[variant="danger"] {
  background: #fbe9e6;
  color: #7f1d1d;
  border-color: #a22c1c;
}

QPushButton[variant="danger"]:hover, QPushButton[variant="danger"]:pressed, QPushButton[variant="danger"]:checked {
  background: #fbe9e6;
}

QPushButton:focus, QPushButton[variant="primary"]:focus, QPushButton[variant="ghost"]:focus, QPushButton[variant="danger"]:focus {
  border-color: #1f5fbf;
}

QPushButton:disabled, QPushButton[variant="primary"]:disabled, QPushButton[variant="ghost"]:disabled, QPushButton[variant="danger"]:disabled {
  background: #eef1f5;
  color: #8b95a3;
  border-color: #d9dee5;
}

