QAbstractItemView {
  background: #ffffff;
  alternate-background-color: #eef1f5;
  color: #5a6676;
  border: 1px solid #d9dee5;
  selection-background-color: #1f5fbf;
  selection-color: #ffffff;
}

QAbstractItemView::item {
  padding: 4px;
}

QAbstractItemView::item:hover:!selected {
  background: #eef1f5;
}

QAbstractItemView::item:selected {
  background: #1f5fbf;
  color: #ffffff;
}

QHeaderView::section, QTableCornerButton::section {
  background: #eef1f5;
  color: #5a6676;
  border: 1px solid #d9dee5;
  padding: 4px;
}

QListWidget[lattice="steps"]::item:selected {
