  background: #eef1f5;
  color: #8b95a3;
}

QComboBox QLineEdit {
  border: none;
  padding: 0px;
  background: transparent;
}

QPlainTextEdit[lattice="code"], QTextEdit[lattice="code"] {
  background: #eef1f5;
  font-family: monospace;
  font-size: 12px;
}

QCheckBox, QRadioButton {
  spacing: 8px;
  background: transparent;
}

QCheckBox:disabled, QRadioButton:disabled {
