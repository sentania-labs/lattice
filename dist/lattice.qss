}

QLabel[lattice="code"] {
  font-size: 12px;
  font-weight: 400;
  font-family: monospace;
}

QLabel[lattice="code-sm"] {
  font-size: 11px;
  font-weight: 400;
  font-family: monospace;
}

QLabel[lattice="section-label"] {
  color: #8b95a3;
}

QLabel[lattice="label"] {
  color: #5a6676;
}

QLabel[lattice="hint"] {
  color: #8b95a3;
}

QLabel[lattice="muted"] {
  color: #5a6676;
}

QLabel[lattice="hint"] {
  font-size: 11.5px;
}

QLabel[lattice="hint"][status="bad"] {
